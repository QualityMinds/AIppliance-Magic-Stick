+++ b/multicast_links_linux_test.go
@@ -0,0 +1,224 @@
+package dnssd
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"os"
+	"os/exec"
+	"testing"
+	"time"
+
+	"github.com/brutella/dnssd/log"
+	"github.com/miekg/dns"
+	"golang.org/x/net/ipv4"
+)
+
+// Opt-in packet-level test. Refuse to create interfaces unless this process
+// is in an empty, disposable network namespace.
+func TestLateIPv4AndRenumberingOnRealMulticastSocket(t *testing.T) {
+	if os.Getenv("MAGICSTICK_TEST_PRIVATE_NETNS") != "1" {
+		t.Skip("requires an explicitly isolated Linux network namespace")
+	}
+	if os.Getenv("MAGICSTICK_TEST_MDNS_TRACE") == "1" {
+		log.Debug.Enable()
+		t.Cleanup(log.Debug.Disable)
+	}
+	ifaces, err := net.Interfaces()
+	if err != nil || len(ifaces) != 1 || ifaces[0].Flags&net.FlagLoopback == 0 {
+		t.Fatalf("expected an empty private namespace: %v, %v", ifaces, err)
+	}
+	ip := func(args ...string) {
+		t.Helper()
+		if out, err := exec.Command("ip", args...).CombinedOutput(); err != nil {
+			t.Fatalf("ip %v: %v: %s", args, err, out)
+		}
+	}
+	// Peers must really reside on the other side of the link. Otherwise
+	// Linux rejects their traffic as a locally sourced packet arriving on
+	// an interface, or delivers the reply by its loopback route.
+	clients := exec.Command("unshare", "--net", "sleep", "60")
+	if err := clients.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		_ = clients.Process.Kill()
+		_ = clients.Wait()
+	})
+	peerNamespace := fmt.Sprintf("/proc/%d/ns/net", clients.Process.Pid)
+	self, err := os.Readlink("/proc/self/ns/net")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for attempt := 0; ; attempt++ {
+		peer, err := os.Readlink(peerNamespace)
+		if err == nil && peer != self {
+			break
+		}
+		if attempt == 100 {
+			t.Fatal("client network namespace was not created")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	inClients := func(command string, args ...string) *exec.Cmd {
+		return exec.Command("nsenter", append([]string{"--net=" + peerNamespace, "--", command}, args...)...)
+	}
+	pair := func(server, client, clientAddress string) {
+		t.Helper()
+		ip("link", "add", server, "type", "veth", "peer", "name", client)
+		ip("link", "set", server, "up")
+		ip("link", "set", client, "netns", fmt.Sprint(clients.Process.Pid))
+		if out, err := inClients("ip", "link", "set", client, "up").CombinedOutput(); err != nil {
+			t.Fatalf("set up client link: %v: %s", err, out)
+		}
+		if out, err := inClients("ip", "addr", "add", clientAddress, "dev", client).CombinedOutput(); err != nil {
+			t.Fatalf("address client link: %v: %s", err, out)
+		}
+	}
+	pair("server-a", "client-a", "192.0.2.2/24")
+	ip("addr", "add", "192.0.2.1/24", "dev", "server-a")
+	pair("server-b", "client-b", "198.51.100.2/24")
+
+	r, err := NewResponder()
+	if err != nil {
+		t.Fatal(err)
+	}
+	svc, err := NewService(Config{
+		Name: "failover-test", Host: "failover-test", Type: "_https._tcp", Port: 443,
+		Ifaces: []string{"server-a", "server-b", "server-c"},
+		InterfaceAddresses: func(iface *net.Interface) []net.IP {
+			addresses, _ := iface.Addrs()
+			var ips []net.IP
+			for _, address := range addresses {
+				ip, _, err := net.ParseCIDR(address.String())
+				if err == nil && ip.To4() != nil {
+					ips = append(ips, ip.To4())
+				}
+			}
+			return ips
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := r.Add(svc); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- r.Respond(ctx) }()
+	t.Cleanup(func() {
+		cancel()
+		select {
+		case <-done:
+		case <-time.After(3 * time.Second):
+			t.Error("mDNS responder did not stop")
+		}
+	})
+
+	check := func(device, source, expected string) {
+		t.Helper()
+		exe, err := os.Executable()
+		if err != nil {
+			t.Fatal(err)
+		}
+		cmd := inClients(exe, "-test.run=^TestPrivateClientQuery$", "-test.timeout=12s")
+		cmd.Env = append(os.Environ(), "MAGICSTICK_TEST_MDNS_DEVICE="+device,
+			"MAGICSTICK_TEST_MDNS_SOURCE="+source, "MAGICSTICK_TEST_MDNS_EXPECTED="+expected)
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("client %s: %v: %s", device, err, out)
+		}
+	}
+
+	check("client-a", "192.0.2.2", "192.0.2.1")
+	// B's carrier is already up; DHCP happens after the responder opens its
+	// sockets. There is no link-up event here to trigger the old responder.
+	ip("addr", "add", "198.51.100.1/24", "dev", "server-b")
+	check("client-b", "198.51.100.2", "198.51.100.1")
+	// C was not present at all when the responder acquired its sockets.
+	pair("server-c", "client-c", "203.0.113.2/24")
+	ip("addr", "add", "203.0.113.1/24", "dev", "server-c")
+	check("client-c", "203.0.113.2", "203.0.113.1")
+	ip("link", "set", "server-a", "down")
+	ip("addr", "del", "198.51.100.1/24", "dev", "server-b")
+	ip("addr", "add", "198.51.100.3/24", "dev", "server-b")
+	check("client-b", "198.51.100.2", "198.51.100.3")
+	ip("link", "set", "server-a", "up")
+	check("client-a", "192.0.2.2", "192.0.2.1")
+}
+
+func TestPrivateClientQuery(t *testing.T) {
+	device := os.Getenv("MAGICSTICK_TEST_MDNS_DEVICE")
+	if os.Getenv("MAGICSTICK_TEST_PRIVATE_NETNS") != "1" || device == "" {
+		t.Skip("helper for the isolated packet test")
+	}
+	source := os.Getenv("MAGICSTICK_TEST_MDNS_SOURCE")
+	expected := os.Getenv("MAGICSTICK_TEST_MDNS_EXPECTED")
+	iface, err := net.InterfaceByName(device)
+	if err != nil {
+		t.Fatal(err)
+	}
+	addrs, err := iface.Addrs()
+	if err != nil {
+		t.Fatal(err)
+	}
+	hasSource := false
+	for _, address := range addrs {
+		ip, _, err := net.ParseCIDR(address.String())
+		hasSource = hasSource || (err == nil && ip.Equal(net.ParseIP(source)))
+	}
+	if !hasSource {
+		t.Fatalf("client %s does not have %s", device, source)
+	}
+	raw, err := net.ListenMulticastUDP("udp4", iface, AddrIPv4LinkLocalMulticast)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	conn := ipv4.NewPacketConn(raw)
+	if err := conn.SetMulticastInterface(iface); err != nil {
+		t.Fatal(err)
+	}
+	if err := conn.SetMulticastTTL(255); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(8 * time.Second)
+	for time.Now().Before(deadline) {
+		msg := new(dns.Msg).SetQuestion("failover-test.local.", dns.TypeA)
+		msg.Id = 0
+		msg.RecursionDesired = false
+		pkt, err := msg.Pack()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := raw.WriteToUDP(pkt, AddrIPv4LinkLocalMulticast); err != nil {
+			t.Fatal(err)
+		}
+		if err := raw.SetReadDeadline(time.Now().Add(250 * time.Millisecond)); err != nil {
+			t.Fatal(err)
+		}
+		var payload [2048]byte
+		n, _, err := raw.ReadFromUDP(payload[:])
+		if err != nil {
+			continue
+		}
+		answer := new(dns.Msg)
+		if answer.Unpack(payload[:n]) != nil || !answer.Response {
+			continue
+		}
+		var records []string
+		for _, resource := range answer.Answer {
+			if a, ok := resource.(*dns.A); ok && a.Hdr.Name == "failover-test.local." {
+				records = append(records, a.A.String())
+			}
+		}
+		if len(records) == 0 {
+			continue
+		}
+		if len(records) != 1 || records[0] != expected {
+			t.Fatalf("%s: wanted %s, got %v", device, expected, records)
+		}
+		return
+	}
+	t.Fatalf("%s: no A record for %s", device, expected)
+}
