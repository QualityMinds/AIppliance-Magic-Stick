+package dnssd
+
+import (
+	"net"
+	"testing"
+)
+
+func TestLinkSnapshotTracksAddressFamilyAndRenumbering(t *testing.T) {
+	iface := &net.Interface{Name: "eth-test", Index: 42}
+	address := func(value string) net.Addr {
+		ip, subnet, err := net.ParseCIDR(value)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return &net.IPNet{IP: ip, Mask: subnet.Mask}
+	}
+	a := address("192.0.2.12/24")
+	b := address("2001:db8::12/64")
+	start := linkForAddresses(iface, []net.Addr{a, b})
+	reordered := linkForAddresses(iface, []net.Addr{b, a})
+	if !start.want4 || !start.want6 || start.addresses != reordered.addresses {
+		t.Fatalf("unexpected dual-stack snapshots: %+v / %+v", start, reordered)
+	}
+	changed := linkForAddresses(iface, []net.Addr{address("192.0.2.13/24")})
+	if !changed.want4 || changed.want6 || changed.addresses == start.addresses {
+		t.Fatalf("renumbering or address loss not reflected: %+v", changed)
+	}
+}
+
+func TestServiceAddressSelectorIsLinkLocalAndNotCached(t *testing.T) {
+	lan := &net.Interface{Name: "wired"}
+	wlan := &net.Interface{Name: "wifi"}
+	links := map[string][]net.IP{
+		lan.Name:  {net.ParseIP("192.0.2.17")},
+		wlan.Name: {net.ParseIP("198.51.100.69")},
+	}
+	svc, err := NewService(Config{
+		Name: "appliance", Type: "_https._tcp", Host: "appliance.example", Port: 443,
+		IPs:                []net.IP{net.ParseIP("203.0.113.88")},
+		InterfaceAddresses: func(iface *net.Interface) []net.IP { return links[iface.Name] },
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	probed := svc.Copy()
+	check := func(iface *net.Interface, want string) {
+		t.Helper()
+		got := probed.IPsAtInterface(iface)
+		if len(got) != 1 || got[0].String() != want {
+			t.Fatalf("%s: got %v, want %s", iface.Name, got, want)
+		}
+	}
+	check(lan, "192.0.2.17")
+	check(wlan, "198.51.100.69")
+	delete(links, wlan.Name)
+	if got := probed.IPsAtInterface(wlan); len(got) != 0 {
+		t.Fatalf("disconnected Wi-Fi returned %v", got)
+	}
+	links[lan.Name] = []net.IP{net.ParseIP("192.0.2.18")}
+	check(lan, "192.0.2.18")
+}
