new file mode 100644
index 0000000..07a2b2e
--- /dev/null
+++ b/multicast_links.go
@@ -0,0 +1,99 @@
+package dnssd
+
+import (
+	"errors"
+	"net"
+	"sort"
+	"strings"
+	"syscall"
+
+	"github.com/brutella/dnssd/log"
+)
+
+type multicastLink struct {
+	iface     *net.Interface
+	addresses string
+	want4     bool
+	want6     bool
+	joined4   bool
+	joined6   bool
+}
+
+func linkForAddresses(iface *net.Interface, addrs []net.Addr) multicastLink {
+	link := multicastLink{iface: iface}
+	var addresses []string
+	for _, addr := range addrs {
+		ip, _, err := net.ParseCIDR(addr.String())
+		if err != nil || ip.IsUnspecified() {
+			continue
+		}
+		addresses = append(addresses, addr.String())
+		if ip.To4() != nil {
+			link.want4 = true
+		} else {
+			link.want6 = true
+		}
+	}
+	sort.Strings(addresses)
+	link.addresses = strings.Join(addresses, ",")
+	return link
+}
+
+// The responder owns these memberships; short-lived probe connections also
+// get their own initial snapshot. A failed join remains pending for the next
+// refresh rather than recording an interface as reachable.
+func (c *mdnsConn) refreshMulticastLinks() bool {
+	next := make(map[int]multicastLink)
+	for _, iface := range MulticastInterfaces(c.interfaceFilter...) {
+		addrs, err := iface.Addrs()
+		if err == nil {
+			next[iface.Index] = linkForAddresses(iface, addrs)
+		}
+	}
+	changed := false
+	group4 := &net.UDPAddr{IP: IPv4LinkLocalMulticast}
+	group6 := &net.UDPAddr{IP: IPv6LinkLocalMulticast}
+	for index, old := range c.links {
+		link, exists := next[index]
+		same := exists && link.iface.Name == old.iface.Name
+		if old.joined4 && (!same || !link.want4) {
+			_ = c.ipv4.LeaveGroup(old.iface, group4)
+		}
+		if old.joined6 && (!same || !link.want6) {
+			_ = c.ipv6.LeaveGroup(old.iface, group6)
+		}
+		if !same {
+			changed = true
+		}
+	}
+	for index, link := range next {
+		old, exists := c.links[index]
+		same := exists && link.iface.Name == old.iface.Name
+		if c.ipv4 != nil && link.want4 {
+			link.joined4 = same && old.joined4
+			if !link.joined4 {
+				err := c.ipv4.JoinGroup(link.iface, group4)
+				link.joined4 = err == nil || errors.Is(err, syscall.EADDRINUSE)
+				if !link.joined4 {
+					log.Debug.Printf("Failed joining IPv4 %v: %v", link.iface.Name, err)
+				}
+			}
+		}
+		if c.ipv6 != nil && link.want6 {
+			link.joined6 = same && old.joined6
+			if !link.joined6 {
+				err := c.ipv6.JoinGroup(link.iface, group6)
+				link.joined6 = err == nil || errors.Is(err, syscall.EADDRINUSE)
+				if !link.joined6 {
+					log.Debug.Printf("Failed joining IPv6 %v: %v", link.iface.Name, err)
+				}
+			}
+		}
+		next[index] = link
+		changed = changed || !same || old.addresses != link.addresses ||
+			old.joined4 != link.joined4 || old.joined6 != link.joined6 ||
+			old.iface.Flags != link.iface.Flags
+	}
+	c.links = next
+	return changed
+}
