+	drapbv1 "k8s.io/kubelet/pkg/apis/dra/v1beta1"
+	"k8s.io/kubernetes/pkg/kubelet/checkpointmanager"
+	cdiapi "tags.cncf.io/container-device-interface/pkg/cdi"
+)
+
+func recoveryFixture(t *testing.T) (*DeviceState, *AmdGpuInfo, string) {
+	t.Helper()
+	dir := t.TempDir()
+	cache, err := cdiapi.NewCache(cdiapi.WithSpecDirs(dir))
+	if err != nil {
+		t.Fatal(err)
+	}
+	manager, err := checkpointmanager.NewCheckpointManager(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	gpu := &AmdGpuInfo{PCIAddress: "0000:01:00.0", DeviceID: "0x1586", cardIndex: 1, renderIndex: 128}
+	s := &DeviceState{cdi: &CDIHandler{cache: cache}, checkpointManager: manager,
+		identityCheck: func(*AmdGpuInfo) error { return nil },
+		allocatable:   AllocatableDevices{gpu.CanonicalName(): {AmdGpu: gpu}}, deviceAttrs: func(path string) (int64, int64, string, string, error) {
+			minor := 0
+			if path == "/dev/kfd" {
+				return 511, 0, "c", "rwm", nil
+			}
+			if strings.Contains(path, "renderD") {
+				fmt.Sscanf(path, "/dev/dri/renderD%d", &minor)
+			} else {
+				fmt.Sscanf(path, "/dev/dri/card%d", &minor)
+			}
+			return 226, int64(minor), "c", "rwm", nil
+		}}
+	if err := manager.CreateCheckpoint(DriverPluginCheckpointFile, newCheckpoint()); err != nil {
+		t.Fatal(err)
+	}
+	return s, gpu, dir
+}
+
+func allocatedClaim(gpu *AmdGpuInfo, uid string) *resourceapi.ResourceClaim {
+	return &resourceapi.ResourceClaim{ObjectMeta: metav1.ObjectMeta{UID: types.UID(uid)},
+		Status: resourceapi.ResourceClaimStatus{Allocation: &resourceapi.AllocationResult{
+			Devices: resourceapi.DeviceAllocationResult{Results: []resourceapi.DeviceRequestAllocationResult{
+				{Driver: consts.DriverName, Pool: "example-node", Device: gpu.CanonicalName(), Request: "gpu"},
+			}},
+		}}}
+}
+
+func TestStableIdentitySurvivesMixedHostDRMRenumbering(t *testing.T) {
+	s, gpu, dir := recoveryFixture(t)
+	claim := allocatedClaim(gpu, "test-claim")
+	before, err := s.Prepare(claim)
+	if err != nil {
+		t.Fatal(err)
+	}
+	files, _ := os.ReadDir(dir)
+	for _, file := range files {
+		if err := os.Remove(filepath.Join(dir, file.Name())); err != nil {
+			t.Fatal(err)
+		}
+	}
+	name := gpu.CanonicalName()
+	gpu.cardIndex, gpu.renderIndex = 2, 129
+	if gpu.CanonicalName() != name {
+		t.Fatal("DRM ordering changed stable identity")
+	}
+	if err := s.restoreCheckpoint(); err != nil {
+		t.Fatal(err)
+	}
+	if len(s.quarantined) != 0 || len(s.publishedDevices()) != 1 {
+		t.Fatal("same hardware must recover")
+	}
+	files, _ = os.ReadDir(dir)
+	if len(files) != 1 {
+		t.Fatal("CDI not restored before registration")
+	}
+	data, _ := os.ReadFile(filepath.Join(dir, files[0].Name()))
+	if !strings.Contains(string(data), "renderD129") || strings.Contains(string(data), "renderD128") {
+		t.Fatalf("stale mapping: %s", data)
+	}
+	after, err := s.Prepare(claim)
+	if err != nil || before[0].CdiDeviceIds[1] != after[0].CdiDeviceIds[1] {
+		t.Fatal("repeated Prepare changed CDI identity", err)
+	}
+}
+
+func TestHardwareIdentityFitsResourceSliceAttributeLimit(t *testing.T) {
+	_, gpu, _ := recoveryFixture(t)
+	gpu.UUID = strings.Repeat("a", 32)
+	gpu.PartitionProfile = "spx_nps1"
+	if len(gpu.HardwareIdentity()) <= resourceapi.DeviceAttributeMaxValueLength {
+		t.Fatal("fixture must exceed the API string attribute limit")
+	}
+	device := gpu.GetDevice()
+	for name, attribute := range device.Attributes {
+		if attribute.StringValue != nil && len(*attribute.StringValue) > resourceapi.DeviceAttributeMaxValueLength {
+			t.Fatalf("attribute %s exceeds the Kubernetes API limit", name)
+		}
+	}
+	if *device.Attributes["hardwareIdentity"].StringValue != gpu.HardwareIdentityHash() {
+		t.Fatal("published identity is not the checkpoint identity digest")
+	}
+}
+
+func TestLegacyCheckpointQuarantinesWithoutPreventingCleanup(t *testing.T) {
+	s, gpu, dir := recoveryFixture(t)
+	cp := newCheckpoint()
+	cp.V1.PreparedClaims["legacy"] = PreparedDevices{&PreparedDevice{Device: drapbv1.Device{DeviceName: "gpu-1-128"}}}
+	if err := s.checkpointManager.CreateCheckpoint(DriverPluginCheckpointFile, cp); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.restoreCheckpoint(); err != nil {
+		t.Fatal("must not abort plugin startup", err)
+	}
+	if len(s.publishedDevices()) != 0 {
+		t.Fatal("unknown old allocation must not be advertised as free")
+	}
+	if _, err := s.Prepare(allocatedClaim(gpu, "new")); err == nil {
+		t.Fatal("quarantine bypass")
+	}
+	files, _ := os.ReadDir(dir)
+	if len(files) != 0 {
+		t.Fatal("must not grant guessed GPU access")
+	}
+	for i := 0; i < 2; i++ {
+		if err := s.Unprepare("legacy"); err != nil {
+			t.Fatal("cleanup must be idempotent without CDI", err)
+		}
+	}
+	if len(s.publishedDevices()) != 1 {
+		t.Fatal("confirmed cleanup did not release quarantine")
+	}
+	if _, err := s.Prepare(allocatedClaim(gpu, "new")); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestKnownMissingOrReplacedHardwareNeverRemaps(t *testing.T) {
+	for _, replacement := range []bool{false, true} {
+		s, gpu, dir := recoveryFixture(t)
+		if _, err := s.Prepare(allocatedClaim(gpu, "old")); err != nil {
+			t.Fatal(err)
+		}
+		delete(s.allocatable, gpu.CanonicalName())
+		if replacement {
+			gpu.UUID = "replacement"
+			s.allocatable[gpu.CanonicalName()] = &AllocatableDevice{AmdGpu: gpu}
+		}
+		other := &AmdGpuInfo{PCIAddress: "0000:02:00.0", DeviceID: "0x1586", cardIndex: 3, renderIndex: 130}
+		s.allocatable[other.CanonicalName()] = &AllocatableDevice{AmdGpu: other}
+		if err := s.restoreCheckpoint(); err != nil {
+			t.Fatal(err)
+		}
+		published := s.publishedDevices()
+		if len(published) != 1 || published[0].Name != other.CanonicalName() {
+			t.Fatal("quarantine should isolate known PCI location")
+		}
+		files, _ := os.ReadDir(dir)
+		if len(files) != 0 {
+			t.Fatal("stale CDI was not revoked")
+		}
+		if _, err := s.Prepare(allocatedClaim(other, "other")); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestMalformedClaimsAndDeviceFailureStayRecoverable(t *testing.T) {
+	s, gpu, _ := recoveryFixture(t)
+	if _, err := s.Prepare(allocatedClaim(gpu, "old")); err != nil {
+		t.Fatal(err)
+	}
+	s.deviceAttrs = func(string) (int64, int64, string, string, error) { return 0, 0, "", "", fmt.Errorf("device missing") }
+	if err := s.restoreCheckpoint(); err != nil {
+		t.Fatal(err)
+	}
+	if len(s.publishedDevices()) != 0 {
+		t.Fatal("missing nodes exposed")
