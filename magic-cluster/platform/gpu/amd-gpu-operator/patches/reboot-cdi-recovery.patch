+	for _, devices := range []PreparedDevices{nil, {nil}, {&PreparedDevice{HardwareIdentity: "invalid"}}} {
+		cp := newCheckpoint()
+		cp.V1.PreparedClaims["broken"] = devices
+		if err := s.checkpointManager.CreateCheckpoint(DriverPluginCheckpointFile, cp); err != nil {
+			t.Fatal(err)
+		}
+		if err := s.restoreCheckpoint(); err != nil {
+			t.Fatal(err)
+		}
+		if len(s.publishedDevices()) != 0 {
+			t.Fatal("malformed record exposed GPU")
+		}
+		if err := s.Unprepare("broken"); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestMultipleConsumersAreNotGarbageCollectedByPlugin(t *testing.T) {
+	s, gpu, _ := recoveryFixture(t)
+	if _, err := s.Prepare(allocatedClaim(gpu, "shared")); err != nil {
+		t.Fatal(err)
