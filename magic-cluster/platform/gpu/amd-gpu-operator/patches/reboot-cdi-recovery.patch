diff --git a/cmd/gpu-kubeletplugin/recovery.go b/cmd/gpu-kubeletplugin/recovery.go
new file mode 100644
index 0000000..5fc1ed8
--- /dev/null
+++ b/cmd/gpu-kubeletplugin/recovery.go
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: Apache-2.0
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	configapi "github.com/ROCm/k8s-gpu-dra-driver/api/amd.com/resource/gpu/v1alpha1"
+	resourceapi "k8s.io/api/resource/v1"
+	klog "k8s.io/klog/v2"
+)
+
+func (s *DeviceState) readDeviceAttrs(path string) (int64, int64, string, string, error) {
+	if s.deviceAttrs != nil {
+		return s.deviceAttrs(path)
+	}
+	return s.getDeviceAttrs(path)
+}
+
+func (s *DeviceState) validateDeviceMapping(gpu *AmdGpuInfo) error {
+	if s.identityCheck != nil {
+		return s.identityCheck(gpu)
+	}
+	for _, name := range []string{fmt.Sprintf("card%d", gpu.cardIndex), fmt.Sprintf("renderD%d", gpu.renderIndex)} {
+		path := filepath.Join("/sys/class/drm", name, "device")
+		physical, err := filepath.EvalSymlinks(path)
+		if err != nil || filepath.Base(physical) != gpu.PCIAddress {
+			return fmt.Errorf("DRM mapping for %s no longer matches the discovered PCI identity", name)
+		}
+		vendor, err := os.ReadFile(filepath.Join(path, "vendor"))
+		if err != nil || strings.TrimSpace(string(vendor)) != "0x1002" {
+			return fmt.Errorf("DRM mapping is no longer AMD")
+		}
+		device, err := os.ReadFile(filepath.Join(path, "device"))
+		if err != nil || strings.TrimSpace(string(device)) != gpu.DeviceID {
+			return fmt.Errorf("DRM device identity changed")
+		}
+	}
+	if hardwareUUID(gpu.cardIndex) != gpu.UUID {
+		return fmt.Errorf("GPU hardware unique ID changed")
+	}
+	return nil
+}
+
+// Keep the original checkpoint until kubelet calls Unprepare. It is kubelet,
+// not this plugin, which knows whether all claim consumers have stopped.
+// Legacy checkpoints have no proven physical identity and must never be
+// silently remapped, even if their old DRM numbers happen to exist again.
+func (s *DeviceState) restoreCheckpoint() error {
+	cp := newCheckpoint()
+	if err := s.checkpointManager.GetCheckpoint(DriverPluginCheckpointFile, cp); err != nil {
+		return fmt.Errorf("unable to read recovery checkpoint: %w", err)
+	}
+	if cp.V1 == nil {
+		return fmt.Errorf("unsupported recovery checkpoint")
+	}
+	s.quarantined = make(map[string]map[string]bool)
+	for uid, devices := range cp.V1.PreparedClaims {
+		if err := s.restoreClaim(uid, devices); err != nil {
+			// Remove stale CDI even on a plugin-only restart where /run survives.
+			if removeErr := s.cdi.DeleteClaimSpecFile(uid); removeErr != nil {
+				return fmt.Errorf("cannot revoke stale CDI for claim %s: %w", uid, removeErr)
+			}
+			s.quarantined[uid] = s.quarantineScope(devices)
+			klog.Errorf("GPU allocation blocked: claim %s quarantined (%v); waiting for kubelet Unprepare, driver remains registered", uid, err)
+		}
+	}
+	return s.checkpointManager.CreateCheckpoint(DriverPluginCheckpointFile, cp)
+}
+
+func (s *DeviceState) restoreClaim(uid string, devices PreparedDevices) error {
+	if len(devices) == 0 {
+		return fmt.Errorf("empty prepared-device record")
+	}
+	results := make([]*resourceapi.DeviceRequestAllocationResult, 0, len(devices))
+	for _, device := range devices {
+		if device == nil || device.HardwareIdentity == "" {
+			return fmt.Errorf("legacy checkpoint has no verified hardware identity")
+		}
+		current := s.allocatable[device.DeviceName]
+		if current == nil || current.AmdGpu == nil || current.AmdGpu.HardwareIdentity() != device.HardwareIdentity {
+			return fmt.Errorf("physical GPU identity changed or disappeared")
+		}
+		results = append(results, &resourceapi.DeviceRequestAllocationResult{Device: device.DeviceName})
+	}
+	// Do not reuse cached node paths, major/minor numbers, or container edits.
+	edits, err := s.applyConfig(configapi.DefaultGpuConfig(), results)
+	if err != nil {
+		return err
+	}
+	for _, device := range devices {
+		device.ContainerEdits = edits[device.DeviceName]
+		device.CdiDeviceIds = s.cdi.GetClaimDevices(uid, []string{device.DeviceName})
+	}
+	return s.cdi.CreateClaimSpecFile(uid, devices)
+}
+
+func (s *DeviceState) quarantineScope(devices PreparedDevices) map[string]bool {
+	blocked := map[string]bool{}
+	if len(devices) == 0 {
+		blocked[""] = true
+	}
+	for _, device := range devices {
+		var identity []string
+		if device == nil || json.Unmarshal([]byte(device.HardwareIdentity), &identity) != nil || len(identity) != 5 || identity[2] == "" {
+			blocked[""] = true // Unknown physical scope: protect the entire AMD pool.
+			continue
+		}
+		blocked[device.DeviceName] = true
+		for name, candidate := range s.allocatable {
+			if candidate.AmdGpu != nil && candidate.AmdGpu.PCIAddress == identity[2] {
+				blocked[name] = true // Includes a replacement at the same PCI location.
+			}
+		}
+	}
+	return blocked
+}
+
+func (s *DeviceState) deviceQuarantined(name string) bool {
+	for _, blocked := range s.quarantined {
+		if blocked[""] || blocked[name] {
+			return true
+		}
+	}
+	return false
+}
+
+func (s *DeviceState) publishedDevices() []resourceapi.Device {
+	s.Lock()
+	defer s.Unlock()
+	devices := make([]resourceapi.Device, 0, len(s.allocatable))
+	for name, device := range s.allocatable {
+		if !s.deviceQuarantined(name) {
+			devices = append(devices, device.GetDevice())
+		}
+	}
+	sort.Slice(devices, func(i, j int) bool { return devices[i].Name < devices[j].Name })
+	return devices
+}
