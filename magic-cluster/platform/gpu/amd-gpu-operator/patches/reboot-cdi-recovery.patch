+// SPDX-License-Identifier: Apache-2.0
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/ROCm/k8s-gpu-dra-driver/pkg/consts"
+	resourceapi "k8s.io/api/resource/v1"
