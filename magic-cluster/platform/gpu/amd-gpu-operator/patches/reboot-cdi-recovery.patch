+	}
+	cp := newCheckpoint()
+	if err := s.checkpointManager.GetCheckpoint(DriverPluginCheckpointFile, cp); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := cp.V1.PreparedClaims["shared"]; !ok {
+		t.Fatal("plugin must wait for kubelet cleanup, not infer consumers from API")
+	}
+}
+
+func TestChangedSysfsMappingRejectsPrepareAndQuarantinesRecovery(t *testing.T) {
+	s, gpu, _ := recoveryFixture(t)
+	if _, err := s.Prepare(allocatedClaim(gpu, "shared")); err != nil {
+		t.Fatal(err)
+	}
+	s.identityCheck = func(*AmdGpuInfo) error { return fmt.Errorf("DRM mapping changed") }
+	if _, err := s.Prepare(allocatedClaim(gpu, "shared")); err == nil {
+		t.Fatal("unsafe current mapping accepted")
+	}
+	if err := s.restoreCheckpoint(); err != nil {
+		t.Fatal(err)
+	}
+	if len(s.publishedDevices()) != 0 {
+		t.Fatal("changed mapping must stay quarantined")
+	}
+	if err := s.Unprepare("shared"); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// Opt-in host acceptance: only reads actual sysfs/device attributes. All
+// checkpoints and CDI specs stay in t.TempDir; no kubelet registration, GPU
+// allocation, model, or live checkpoint is changed.
+func TestLiveAMDDiscoveryAndRecoveryInIsolatedDirectories(t *testing.T) {
+	if os.Getenv("MAGICSTICK_TEST_LIVE_DISCOVERY") != "1" {
+		t.Skip("requires opt-in AMD host")
+	}
+	config := &Config{flags: &Flags{cdiRoot: t.TempDir(), kubeletPluginsDirectoryPath: t.TempDir()}}
+	manager, err := checkpointmanager.NewCheckpointManager(config.DriverPluginPath())
+	if err != nil {
+		t.Fatal(err)
+	}
+	cp := newCheckpoint()
+	cp.V1.PreparedClaims["legacy-test"] = PreparedDevices{&PreparedDevice{Device: drapbv1.Device{DeviceName: "gpu-1-128"}}}
+	if err := manager.CreateCheckpoint(DriverPluginCheckpointFile, cp); err != nil {
+		t.Fatal(err)
+	}
+	s, err := NewDeviceState(config)
+	if err != nil {
+		t.Fatal("legacy record prevented startup", err)
+	}
+	if len(s.allocatable) == 0 {
+		t.Fatal("no live AMD GPU found")
+	}
+	if len(s.publishedDevices()) != 0 {
+		t.Fatal("legacy state was not quarantined")
+	}
+	if err := s.Unprepare("legacy-test"); err != nil {
+		t.Fatal(err)
+	}
+	for _, device := range s.allocatable {
+		if device.AmdGpu == nil {
+			continue
+		}
+		if _, err := s.Prepare(allocatedClaim(device.AmdGpu, "isolated-live-test")); err != nil {
+			t.Fatal(err)
+		}
+		files, _ := os.ReadDir(config.flags.cdiRoot)
+		for _, file := range files {
+			if err := os.Remove(filepath.Join(config.flags.cdiRoot, file.Name())); err != nil {
+				t.Fatal(err)
+			}
+		}
+		restarted, err := NewDeviceState(config)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(restarted.quarantined) != 0 {
+			t.Fatal("unchanged live GPU failed restart recovery")
+		}
+		if err := restarted.Unprepare("isolated-live-test"); err != nil {
+			t.Fatal(err)
+		}
+		break
+	}
+}
