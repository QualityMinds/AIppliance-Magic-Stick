{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "17927352782736106586"
    }
  },
  "parameters": {
    "name": {
      "type": "string",
      "defaultValue": "magic-stick-landingpage",
      "metadata": {
        "description": "Name of the Static Web App. Must match the existing resource to adopt it."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "westeurope",
      "metadata": {
        "description": "Azure region of the Static Web App."
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "Standard",
      "allowedValues": [
        "Free",
        "Standard"
      ],
      "metadata": {
        "description": "Static Web Apps plan. Standard is required for staging environments with custom auth and SLA."
      }
    },
    "repositoryUrl": {
      "type": "string",
      "defaultValue": "https://github.com/QualityMinds/AIppliance-Magic-Stick",
      "metadata": {
        "description": "Source repository linked to the Static Web App."
      }
    },
    "branch": {
      "type": "string",
      "defaultValue": "main",
      "metadata": {
        "description": "Production branch of the linked repository."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Optional resource tags."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/staticSites",
      "apiVersion": "2024-11-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "[parameters('skuName')]",
        "tier": "[parameters('skuName')]"
      },
      "properties": {
        "repositoryUrl": "[parameters('repositoryUrl')]",
        "branch": "[parameters('branch')]",
        "provider": "GitHub",
        "stagingEnvironmentPolicy": "Enabled",
        "allowConfigFileUpdates": true,
        "enterpriseGradeCdnStatus": "Disabled"
      }
    }
  ],
  "outputs": {
    "id": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/staticSites', parameters('name'))]"
    },
    "defaultHostname": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/staticSites', parameters('name')), '2024-11-01').defaultHostname]"
    }
  }
}