[Unit]
Description=Apply an explicitly approved Magic Stick network trial
After=network-online.target k3s.service
ConditionPathExists=/var/lib/magicstick/host-management/approved-network.json

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/magicstick/host-management/network_apply.py apply
ExecStopPost=/usr/bin/python3 /usr/local/lib/magicstick/host-management/network_apply.py recover
TimeoutStartSec=6min
TimeoutStopSec=2min
Restart=no
NoNewPrivileges=true
ProtectHome=read-only
