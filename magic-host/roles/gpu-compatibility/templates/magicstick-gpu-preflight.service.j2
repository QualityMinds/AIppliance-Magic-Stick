[Unit]
Description=Publish non-secret Magic Stick GPU host evidence
After=k3s.service
ConditionPathExists=/etc/rancher/k3s/k3s.yaml
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group=root
Environment=MAGICSTICK_GPU_NODE_NAME={{ gpu_compatibility_node_name }}
ExecStart=/usr/local/sbin/magicstick-gpu-publish
TimeoutStartSec=120
Restart=on-failure
RestartSec=10s
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
