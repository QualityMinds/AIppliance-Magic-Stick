write-kubeconfig-mode: "0644"
node-name: "{{ node_name }}"

tls-san:
{% for tls_san in k3s_tls_sans %}
  - {{ tls_san | to_json }}
{% endfor %}

{% if k3s_oidc_ca.stat.exists | default(false) %}
kube-apiserver-arg:
  - {{ ('oidc-issuer-url=' ~ k3s_oidc_issuer_url) | to_json }}
  - {{ ('oidc-client-id=' ~ k3s_oidc_client_id) | to_json }}
  - {{ ('oidc-username-claim=' ~ k3s_oidc_username_claim) | to_json }}
  - {{ ('oidc-username-prefix=' ~ k3s_oidc_username_prefix) | to_json }}
  - {{ ('oidc-groups-claim=' ~ k3s_oidc_groups_claim) | to_json }}
  - {{ ('oidc-groups-prefix=' ~ k3s_oidc_groups_prefix) | to_json }}
  - {{ ('oidc-ca-file=' ~ k3s_oidc_ca_file) | to_json }}
{% endif %}

disable:
  - traefik

kubelet-arg:
  - "eviction-hard=memory.available<128Mi"
  - "system-reserved=memory=128Mi,cpu=250m"
  - "kube-reserved=memory=128Mi,cpu=250m"
