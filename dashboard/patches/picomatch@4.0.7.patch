+// Magic Stick: GHSA-fc5q-39xc-vjpf also affects a single repeated branch.
+// An unescaped glob star nests an unbounded quantifier inside +(...) or *(...).
+// Keep quoted, escaped and bracket-literal stars intact. Existing flattenable
+// character-star sequences are handled before this conservative fallback.
+const hasUnboundedGlobStar = branch => {
+  const posixClasses = Object.keys(POSIX_REGEX_SOURCE).map(name => `[:${name}:]`);
+  let escaped = false;
+  let quoted = false;
+  let bracket = false;
+
+  for (let index = 0; index < branch.length; index++) {
+    const ch = branch[index];
+    if (escaped) {
+      escaped = false;
+    } else if (ch === '\\') {
+      escaped = true;
+    } else if (ch === '"' && !bracket) {
+      quoted = !quoted;
+    } else if (!quoted) {
+      if (ch === '[' && !bracket) {
+        bracket = true;
+      } else if (ch === '[' && bracket && branch[index + 1] === ':') {
+        const posix = posixClasses.find(value => branch.startsWith(value, index));
+        if (posix) {
+          index += posix.length - 1;
+        }
+      } else if (ch === ']') {
+        bracket = false;
+      } else if (ch === '*' && !bracket && branch[index + 1] !== '(') {
+        return true;
+      }
+    }
+  }
+
+  return false;
+};
